{{/* gotype: entgo.io/ent/entc/gen.typeScope */}}

{{ define "dialect/sql/select" }}
{{ $builder := pascal $.Scope.Builder }}
{{ $receiver := $.Scope.Receiver }}

func ({{ $receiver }} *{{ $builder }}) sqlScan(ctx context.Context, root *{{ $.QueryName }}, v any) error {
	selector := root.sqlQuery(ctx)
	aggregation := make([]string, 0, len({{ $receiver}}.fns))
	for _, fn := range {{ $receiver }}.fns {
		aggregation = append(aggregation, fn(selector))
	}
	switch n := len(*{{ $receiver }}.selector.flds); {
	{{- /* If no columns were selected, the default selection is the aggregation.*/}}
	case n == 0 && len(aggregation) > 0:
		selector.Select(aggregation...)
	case n != 0 && len(aggregation) > 0:
		selector.AppendSelect(aggregation...)
	}
	rows := &sql.Rows{}
	query, args := selector.Query()
	if err := {{ $receiver }}.driver.Query(ctx, query, args, rows); err != nil {
		return err
	}
	defer rows.Close()
	{{ template "dialect/sql/scan" $ }}
}

{{- if $.JSONOptionsFields }}
	// {{ $.Package }}ScanRows supplies schema JSON options for projected columns.
	type {{ $.Package }}ScanRows struct {
		sql.ColumnScanner
	}

	func ({{ $.Package }}ScanRows) JSONOptions(column string) []jsonv2.Options {
		switch column {
		{{- range $f := $.JSONOptionsFields }}
			case {{ $.Package }}.{{ $f.Constant }}:
				return {{ $f.JSONOptions }}
		{{- end }}
		default:
			return []jsonv2.Options{json.DefaultOptionsV1()}
		}
	}
{{- end }}

{{/* Allow adding methods to the select-builder by ent extensions or user templates.*/}}
{{ with $tmpls := matchTemplate "dialect/sql/select/additional/*" }}
	{{- range $tmpl := $tmpls }}
		{{- xtemplate $tmpl $ }}
	{{- end }}
{{ end }}

{{ end }}

{{/* Supply schema options through the optional JSON extension. */}}
{{ define "dialect/sql/scan" }}
	{{- if $.JSONOptionsFields }}
		return sql.ScanSlice({{ $.Package }}ScanRows{rows}, v)
	{{- else }}
		return sql.ScanSlice(rows, v)
	{{- end }}
{{ end }}
